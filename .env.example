# Public URL and local calendar used by links and daily summaries
TERACOTA_PUBLIC_URL=https://teracota.matoug.com
TERACOTA_TIMEZONE=America/Toronto
TERACOTA_ENV=production
TERACOTA_SECRET_KEY=replace-with-a-long-random-value
TERACOTA_USERNAME=teraview
TERACOTA_PASSWORD=replace-with-a-strong-password
TERACOTA_DB_PATH=/var/lib/teracota/teracota.sqlite3
TERACOTA_BEHIND_PROXY=true
TERACOTA_COOKIE_SECURE=true
TERACOTA_SEED_DEMO=false

# Measurement History uploads and compact analytics
TERACOTA_MEASUREMENT_DATA_DIR=/var/lib/teracota/measurements
TERACOTA_MEASUREMENT_UPLOAD_TOKEN=replace-with-a-different-long-random-value
TERACOTA_MEASUREMENT_STORAGE_BACKEND=filesystem
TERACOTA_MEASUREMENT_MAX_UPLOAD_BYTES=26214400
TERACOTA_MEASUREMENT_MAX_ARCHIVE_BYTES=2147483648

# Rotating application log shown in the read-only admin monitoring panel
TERACOTA_APP_LOG_PATH=/var/lib/teracota/logs/teracota.log
TERACOTA_APP_LOG_MAX_BYTES=5242880
TERACOTA_APP_LOG_BACKUPS=5

# Gmail SMTP. Use a Google app password, never the normal account password.
TERACOTA_SMTP_HOST=smtp.gmail.com
TERACOTA_SMTP_PORT=465
TERACOTA_SMTP_SECURITY=ssl
TERACOTA_SMTP_USERNAME=notifications@example.com
TERACOTA_SMTP_APP_PASSWORD=replace-with-google-app-password
TERACOTA_SMTP_FROM=notifications@example.com

# Optional private S3 storage instead of the Lightsail filesystem:
# TERACOTA_MEASUREMENT_STORAGE_BACKEND=s3
# TERACOTA_MEASUREMENT_STORAGE_BUCKET=your-private-bucket
# AWS_REGION=us-east-1
