[Unit]
Description=Queue the previous-day TeraCota operations summary
After=network-online.target teracota.service
Wants=network-online.target

[Service]
Type=oneshot
User=teracota
Group=teracota
WorkingDirectory=/opt/teracota
EnvironmentFile=/opt/teracota/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/teracota/.venv/bin/python -m email_notifications daily
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/teracota
